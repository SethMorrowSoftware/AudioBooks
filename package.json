{
  "name": "librivox-audiobooks",
  "version": "1.0.0",
  "private": true,
  "description": "Static web app for streaming free LibriVox audiobooks from Archive.org",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o tailwind.css --watch",
    "test": "node scripts/lint.mjs && node --test 'test/*.test.mjs'",
    "serve": "python3 -m http.server 8080",
    "lint": "node scripts/lint.mjs",
    "e2e": "node test/e2e/journeys.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "playwright": "^1.49.1"
  }
}
